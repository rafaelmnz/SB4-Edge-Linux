From: sb4edge-linux
Subject: sdcp: model certificate verification fixes

1. fpi_sdcp_verify_certificate() freed param after X509_STORE_set1_param() but
   kept the pointer, and its error paths freed it again: a failed check
   aborted the process (double free) instead of returning the error.
2. The EgisTec 1c7a:05a1 (firmware 9050.1.2.32) model certificate names its
   issuer "O=Microsoft Cor\x00oration", so OpenSSL finds no issuer by name
   ("unable to get local issuer certificate"). Only in that case, and only when
   that byte sequence occurs exactly once, restore the 'p' and run the same
   verification again on the repaired certificate: the CA must have signed it
   byte for byte and the chain must verify against the truststore, with the
   same parameters (X509_STRICT, no time check) as any other model certificate.
---
--- a/libfprint/fpi-sdcp.c
+++ b/libfprint/fpi-sdcp.c
@@ -24,6 +24,7 @@
 #include "sdcp/fpi-sdcp-truststore-resource.h"
 
 #include <openssl/core_names.h>
+#include <openssl/x509v3.h>
 #include <openssl/ecdh.h>
 #include <openssl/evp.h>
 #include <openssl/err.h>
@@ -221,6 +222,42 @@
   return NULL;
 }
 
+/*
+ * The EgisTec 1c7a:05a1 (firmware 9050.1.2.32) sends its model certificate with
+ * one byte zeroed: the 'p' of "Microsoft Corporation" in the issuer name, so
+ * OpenSSL finds no issuer by name. Return a copy with exactly that byte restored
+ * (only when that byte sequence occurs once), or NULL. The copy then goes
+ * through the normal verification: the CA's signature must match it byte for
+ * byte, and the whole chain must verify against the truststore.
+ */
+static X509 *
+fpi_sdcp_repair_model_certificate (X509 *certificate)
+{
+  static const guchar damaged[] = "Microsoft Cor\0oration";
+  const gsize n = sizeof (damaged) - 1;
+  unsigned char *der = NULL;
+  const unsigned char *p;
+  int der_len = i2d_X509 (certificate, &der);
+  int at = -1, count = 0;
+  X509 *fixed = NULL;
+
+  for (int i = 0; der && i + (int) n <= der_len; i++)
+    if (memcmp (der + i, damaged, n) == 0)
+      {
+        at = i;
+        count++;
+      }
+
+  if (count == 1)
+    {
+      der[at + 13] = 'p';
+      p = der;
+      fixed = d2i_X509 (NULL, &p, der_len);
+    }
+  OPENSSL_free (der);
+  return fixed;
+}
+
 static gboolean
 fpi_sdcp_verify_certificate (X509    *certificate,
                              GError **error)
@@ -257,15 +294,33 @@
   if (!X509_STORE_set1_param (sdcp_truststore, param))
     goto out_error;
 
-  X509_VERIFY_PARAM_free (param);
+  g_clear_pointer (&param, X509_VERIFY_PARAM_free);
   ctx = X509_STORE_CTX_new ();
 
   if(!X509_STORE_CTX_init (ctx, sdcp_truststore, certificate, NULL))
     goto out_verify_error;
 
   if (!X509_verify_cert (ctx))
-    goto out_verify_error;
+    {
+      X509 *repaired;
+      gboolean verified;
 
+      if (X509_STORE_CTX_get_error (ctx) != X509_V_ERR_UNABLE_TO_GET_ISSUER_CERT_LOCALLY)
+        goto out_verify_error;
+      repaired = fpi_sdcp_repair_model_certificate (certificate);
+      if (!repaired)
+        goto out_verify_error;
+
+      /* Same truststore and parameters, now on the repaired certificate */
+      X509_STORE_CTX_cleanup (ctx);
+      ERR_clear_error ();
+      verified = X509_STORE_CTX_init (ctx, sdcp_truststore, repaired, NULL) && X509_verify_cert (ctx) == 1;
+      X509_free (repaired);
+      if (!verified)
+        goto out_verify_error;
+      fp_info ("SDCP: model certificate verified once its zeroed issuer byte was restored");
+    }
+
   X509_STORE_CTX_free (ctx);
 
   return TRUE;
