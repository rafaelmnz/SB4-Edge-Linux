# Expected matches for check-secrets.sh: file, a tab, then the exact line. Public or generic data only.
dev/sb4dev/setup.sh	install -d -m700 -o ubuntu -g ubuntu /home/ubuntu/.ssh
dev/sb4dev/setup.sh	install -m600 -o ubuntu -g ubuntu "$D/authorized_keys" /home/ubuntu/.ssh/authorized_keys
fluence/harness/ab.sh	for v in $V; do install -o ubuntu -g ubuntu -m 644 ${v%%:*}.wav /home/ubuntu/Desktop/ 2>/dev/null; done
