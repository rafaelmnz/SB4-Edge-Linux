# Samsung Galaxy Book4 Edge: usbcore is built in, so a modprobe.d autosuspend option never applies.
# Hubs autosuspend after 2 s and USB-C hubs/docks drop off the bus (omarchy gb4e notes); keep hubs awake.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{bDeviceClass}=="09", TEST=="power/control", ATTR{power/control}="on"
# The fingerprint reader (EgisTec ETU905A80-E) is the exception: usbcore.autosuspend=-1 keeps it awake, which keeps
# its USB controller out of low power. Letting it sleep after 2 s saves about 0.5 W at idle (measured 2026-11-16);
# unlock and sudo by fingerprint still work with no added delay.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1c7a", ATTR{idProduct}=="05a1", TEST=="power/control", ATTR{power/autosuspend_delay_ms}="2000", ATTR{power/control}="auto"
