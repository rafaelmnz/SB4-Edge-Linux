[Unit]
Description=USB-C power role switching for the Samsung Galaxy Book4 Edge (S2MM006 PD controllers)
# It writes to the USB-C PD controllers over I2C; never run it on another machine.
ConditionFirmware=|device-tree-compatible(samsung,galaxy-book4-edge-16)
ConditionFirmware=|device-tree-compatible(samsung,galaxy-book4-edge-14)

[Service]
ExecStartPre=/sbin/modprobe i2c-dev
ExecStart=/usr/libexec/sb4edge-usbc
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
