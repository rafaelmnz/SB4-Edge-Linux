#!/usr/bin/python3 -I
"""sb4edge: keep the GNOME fixes in place across package and release upgrades.

Run after every dpkg run (/etc/apt/apt.conf.d/99-sb4edge-gnome-persist) and at every boot before the login screen
(sb4edge-gnome-persist.service). Idempotent; each step reports and carries on if it can't apply.
  1. Ubuntu Dock / AppIndicators patches (sb4edge-dock-fix).
  2. Login screen overlay for fingerprint login at the user chooser (sb4edge-gdm-fp-overlay), and its line in
     /etc/pam.d/gdm-password and gdm-fingerprint (conffiles a release upgrade may replace).
     In gdm-password, Ubuntu's common-auth pam_fprintd is skipped so GDM's background fingerprint service gets
     the reader (fingerprint then works on the lock screen even with text typed in the password field).
  3. The login screen gets the users' display configuration (newest ~/.config/monitors.xml -> /etc/xdg), so the
     hand-over from the login screen keeps the same hardware plane assignment (otherwise page flips failed for
     minutes after login with two monitors).
  4. Softer edges for GTK right-click/app menus in each user's gtk.css (and /etc/skel).
  5. sb4edge's own GNOME Shell extensions (and the patched hidetopbar) declare the running GNOME Shell version, so a
     GNOME major upgrade doesn't silently disable them (the shell only loads extensions listing its version; one
     that really breaks is shown as an error and the shell keeps running).
"""
import glob
import json
import os
import re
import subprocess
import sys

LIB = "/usr/lib/sb4edge"
PAM_LINE = "auth\t[success=done default=ignore]\tpam_exec.so quiet quiet_log /usr/lib/sb4edge/sb4edge-fp-token"
OWN_EXTENSIONS = ["hidetopbar-multimonitor@linuxitos.local", "*@sb4edge"]


def log(msg):
    print(f"sb4edge-gnome-persist: {msg}", flush=True)


def run(cmd):
    if os.access(cmd, os.X_OK):
        r = subprocess.run([cmd], capture_output=True, text=True)
        for line in (r.stdout + r.stderr).splitlines():
            log(line)


# PAM files and the line our token check goes before: gdm-password is what Ubuntu's login screen actually uses for
# fingerprint (common-auth has pam_fprintd); gdm-fingerprint is kept for other setups.
PAM_TARGETS = [("/etc/pam.d/gdm-password", r"^@include\s+common-auth\b.*$"),
               ("/etc/pam.d/gdm-fingerprint", r"^auth\s+required\s+pam_fprintd\.so.*$")]


def write_pam(path, text):
    tmp = path + ".sb4edge-tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, os.stat(path).st_mode & 0o7777)
    os.replace(tmp, path)


def pam_line():
    if not os.access(f"{LIB}/sb4edge-fp-token", os.X_OK):
        return
    for path, anchor in PAM_TARGETS:
        try:
            src = open(path).read()
        except FileNotFoundError:
            continue
        if PAM_LINE in src:
            continue
        old = re.search(r"^auth\s.*sb4edge-fp-token.*$", src, re.M)
        if old:                               # an older form of our line: replace it
            write_pam(path, src[:old.start()] + PAM_LINE + src[old.end():])
            log(f"{path}: user-chooser token check updated")
            continue
        m = re.search(anchor, src, re.M)
        if not m:
            log(f"{path}: expected line not found, not adding the user-chooser token check")
            continue
        write_pam(path, src[:m.start()] + "# sb4edge: one-time match from the GDM user chooser (sb4edge-fp-identify)\n"
                  + PAM_LINE + "\n" + src[m.start():])
        log(f"{path}: user-chooser token check added")


SKIP_LINE = "auth\t[success=1 default=ignore]\tpam_permit.so\t# sb4edge-skip-fprintd"


def pam_skip_fprintd():
    """In gdm-password, skip the pam_fprintd that Ubuntu puts first in common-auth.

    Otherwise it and GDM's background fingerprint service (gdm-fingerprint) both claim the reader when a login or
    lock prompt starts; it usually wins, waits 10 s, and gives up for good once you type, so the lock screen
    ignored the finger while text was in the password field. Only added while common-auth starts with
    pam_fprintd (the skip jumps over exactly one module)."""
    path = "/etc/pam.d/gdm-password"
    try:
        src = open(path).read()
        common = open("/etc/pam.d/common-auth").read()
    except FileNotFoundError:
        return
    auth = [l for l in common.splitlines() if re.match(r"^auth\s", l)]
    first_is_fprintd = bool(auth) and "pam_fprintd.so" in auth[0]
    has = "sb4edge-skip-fprintd" in src
    if first_is_fprintd and not has:
        m = re.search(r"^@include\s+common-auth\b.*$", src, re.M)
        if not m:
            return
        write_pam(path, src[:m.start()] + "# sb4edge: leave the fingerprint reader to gdm-fingerprint (see sb4edge-gnome-persist)\n"
                  + SKIP_LINE + "\n" + src[m.start():])
        log(f"{path}: skips common-auth's pam_fprintd")
    elif has and not first_is_fprintd:          # common-auth changed: the skip would hit the wrong module
        write_pam(path, re.sub(r"^# sb4edge: leave the fingerprint reader.*\n", "", re.sub(r"^.*sb4edge-skip-fprintd.*\n", "", src, flags=re.M), flags=re.M))
        log(f"{path}: common-auth no longer starts with pam_fprintd, skip removed")


def greeter_monitors():
    """Give the login screen the same display configuration as the users (newest ~/.config/monitors.xml).

    With two monitors, the login screen's default layout assigned hardware planes differently from the user's
    session; after login mutter tried to move a plane between CRTCs in one commit, the kernel refused
    ("[PLANE:..] switching CRTC directly"), and hundreds of page flips per minute failed (a sluggish desktop)
    until the next full modeset. Same layout on both sides avoids that."""
    found = sorted(glob.glob("/home/*/.config/monitors.xml"), key=lambda f: os.path.getmtime(f), reverse=True)
    if not found:
        return
    dst = "/etc/xdg/monitors.xml"
    data = open(found[0], "rb").read()
    try:
        if open(dst, "rb").read() == data:
            return
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = dst + ".sb4edge-tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.chmod(tmp, 0o644)
    os.replace(tmp, dst)
    log(f"{dst}: login screen uses the display setup from {found[0]}")


MENU_CSS = {"gtk-4.0": "/* sb4edge-smooth-menus: right-click and app menus with a hairline outline and the shadow kept under the menu\n   (Yaru's 23 % black outline, and any side shadow, read as a grey bar on a white window behind the menu). */\npopover.menu.background > contents,\npopover.menu.background > arrow {\n  border-color: rgba(0, 0, 0, 0.13);\n  box-shadow: 0 2px 3px -1px rgba(0, 0, 0, 0.10);\n  outline: 1px solid rgba(0, 0, 0, 0.09);\n  outline-offset: -1px;\n  /* 99.5 % opaque on purpose: a fully opaque menu makes GTK report an opaque region slightly larger than what it\n     paints (at 150 %), and GNOME then skips drawing the window behind that strip, so the wallpaper shows through */\n  background-color: rgba(250, 250, 250, 0.995);\n}\n@media (prefers-color-scheme: dark) {\n  popover.menu.background > contents,\n  popover.menu.background > arrow {\n    border-color: rgba(255, 255, 255, 0.08);\n    box-shadow: 0 2px 3px -1px rgba(0, 0, 0, 0.4);\n    outline: 1px solid rgba(255, 255, 255, 0.08);\n    outline-offset: -1px;\n    background-color: rgba(29, 29, 29, 0.995);\n  }\n}\n",
            "gtk-3.0": '/* sb4edge-smooth-menus: same softer menu edges for GTK3 apps (Yaru: 1 px #c7c7c7 / 23 % outline, hard shadow). */\nmenu, .menu, .context-menu {\n  border-color: rgba(0, 0, 0, 0.13);\n}\npopover.background.menu, .csd popover.background.menu {\n  background-color: rgba(250, 250, 250, 0.995);\n  border-color: rgba(0, 0, 0, 0.13);\n  box-shadow: 0 2px 3px -1px rgba(0, 0, 0, 0.10);\n  outline: 1px solid rgba(0, 0, 0, 0.09);\n  outline-offset: -1px;\n}\n'}


def smooth_menus():
    """Softer right-click/app menu edges for GTK4 and GTK3 apps (faint outline, soft shadow instead of Yaru's 23 %
    black outline and hard 1 px shadow, which read as a thin dark line). Added to each user's gtk.css and to
    /etc/skel when missing; a line "sb4edge-smooth-menus: off" in that gtk.css keeps it out."""
    homes = [h for h in glob.glob("/home/*") if os.path.isdir(os.path.join(h, ".config"))] + ["/etc/skel"]
    for home in homes:
        for ver, css in MENU_CSS.items():
            path = os.path.join(home, ".config", ver, "gtk.css")
            try:
                cur = open(path).read()
            except FileNotFoundError:
                cur = ""
            if "sb4edge-smooth-menus" in cur:
                continue
            d = os.path.dirname(path)
            created = not os.path.isdir(d)
            os.makedirs(d, exist_ok=True)
            with open(path, "a") as f:
                f.write(("\n" if cur and not cur.endswith("\n") else "") + css)
            if home != "/etc/skel":
                st = os.stat(home)
                for q in ([os.path.dirname(d), d] if created else []) + [path]:
                    os.chown(q, st.st_uid, st.st_gid)
            log(f"{path}: softer menu edges added")


def shell_major():
    try:
        out = subprocess.run(["gnome-shell", "--version"], capture_output=True, text=True).stdout
        return re.search(r"(\d+)", out).group(1)
    except (OSError, AttributeError):
        return None


def extension_versions():
    major = shell_major()
    if not major:
        return
    roots = ["/usr/share/gnome-shell/extensions"] + glob.glob("/home/*/.local/share/gnome-shell/extensions")
    for root in roots:
        for pattern in OWN_EXTENSIONS:
            for meta in glob.glob(os.path.join(root, pattern, "metadata.json")):
                try:
                    data = json.load(open(meta))
                except (OSError, ValueError):
                    continue
                versions = [str(v) for v in data.get("shell-version", [])]
                if major in versions or any(v.split(".")[0] == major for v in versions):
                    continue
                data["shell-version"] = versions + [major]
                st = os.stat(meta)
                tmp = meta + ".sb4edge-tmp"
                with open(tmp, "w") as f:
                    json.dump(data, f, indent=2)
                    f.write("\n")
                os.chmod(tmp, st.st_mode & 0o7777)
                os.chown(tmp, st.st_uid, st.st_gid)
                os.replace(tmp, meta)
                log(f"{meta}: now declares GNOME Shell {major}")


if os.geteuid() != 0:
    sys.exit("run as root")
run(f"{LIB}/sb4edge-dock-fix")
run(f"{LIB}/sb4edge-gdm-fp-overlay")
pam_line()
pam_skip_fprintd()
greeter_monitors()
smooth_menus()
extension_versions()
