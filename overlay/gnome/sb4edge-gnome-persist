#!/usr/bin/python3 -I
"""sb4edge: keep the GNOME fixes in place across package and release upgrades.

Run after every dpkg run (/etc/apt/apt.conf.d/99-sb4edge-gnome-persist) and at every boot before the login screen
(sb4edge-gnome-persist.service). Idempotent; each step reports and carries on if it can't apply.
  1. Ubuntu Dock / AppIndicators patches (sb4edge-dock-fix).
  2. Login screen overlay for fingerprint login at the user chooser (sb4edge-gdm-fp-overlay), and its line in
     /etc/pam.d/gdm-fingerprint (a conffile a release upgrade may replace).
  3. sb4edge's own GNOME Shell extensions (and the patched hidetopbar) declare the running GNOME Shell version, so a
     GNOME major upgrade doesn't silently disable them (the shell only loads extensions listing its version; one
     that really breaks is shown as an error and the shell keeps running).
"""
import glob
import json
import os
import re
import subprocess
import sys

LIB = "/usr/lib/sb4edge"
PAM = "/etc/pam.d/gdm-fingerprint"
PAM_LINE = "auth\t[success=done default=ignore]\tpam_exec.so quiet /usr/lib/sb4edge/sb4edge-fp-token"
OWN_EXTENSIONS = ["hidetopbar-multimonitor@linuxitos.local", "*@sb4edge"]


def log(msg):
    print(f"sb4edge-gnome-persist: {msg}", flush=True)


def run(cmd):
    if os.access(cmd, os.X_OK):
        r = subprocess.run([cmd], capture_output=True, text=True)
        for line in (r.stdout + r.stderr).splitlines():
            log(line)


def pam_line():
    try:
        src = open(PAM).read()
    except FileNotFoundError:
        return
    if "sb4edge-fp-token" in src or not os.access(f"{LIB}/sb4edge-fp-token", os.X_OK):
        return
    m = re.search(r"^auth\s+required\s+pam_fprintd\.so.*$", src, re.M)
    if not m:
        log(f"{PAM}: no pam_fprintd line, not adding the user-chooser token check")
        return
    new = src[:m.start()] + "# sb4edge: one-time match from the GDM user chooser (sb4edge-fp-identify)\n" + PAM_LINE + "\n" + src[m.start():]
    tmp = PAM + ".sb4edge-tmp"
    with open(tmp, "w") as f:
        f.write(new)
    os.chmod(tmp, os.stat(PAM).st_mode & 0o7777)
    os.replace(tmp, PAM)
    log(f"{PAM}: user-chooser token check added back")


def shell_major():
    try:
        out = subprocess.run(["gnome-shell", "--version"], capture_output=True, text=True).stdout
        return re.search(r"(\d+)", out).group(1)
    except (OSError, AttributeError):
        return None


def extension_versions():
    major = shell_major()
    if not major:
        return
    roots = ["/usr/share/gnome-shell/extensions"] + glob.glob("/home/*/.local/share/gnome-shell/extensions")
    for root in roots:
        for pattern in OWN_EXTENSIONS:
            for meta in glob.glob(os.path.join(root, pattern, "metadata.json")):
                try:
                    data = json.load(open(meta))
                except (OSError, ValueError):
                    continue
                versions = [str(v) for v in data.get("shell-version", [])]
                if major in versions or any(v.split(".")[0] == major for v in versions):
                    continue
                data["shell-version"] = versions + [major]
                st = os.stat(meta)
                tmp = meta + ".sb4edge-tmp"
                with open(tmp, "w") as f:
                    json.dump(data, f, indent=2)
                    f.write("\n")
                os.chmod(tmp, st.st_mode & 0o7777)
                os.chown(tmp, st.st_uid, st.st_gid)
                os.replace(tmp, meta)
                log(f"{meta}: now declares GNOME Shell {major}")


if os.geteuid() != 0:
    sys.exit("run as root")
run(f"{LIB}/sb4edge-dock-fix")
run(f"{LIB}/sb4edge-gdm-fp-overlay")
pam_line()
extension_versions()
