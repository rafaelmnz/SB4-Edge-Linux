#!/usr/bin/python3 -I
# sb4edge: fixes for Ubuntu's bundled GNOME Shell extensions (package gnome-shell-ubuntu-extensions).
# Idempotent; re-run by /etc/apt/apt.conf.d/99-sb4edge-dock-fix after package updates. Each patch is applied
# on its own and skipped (with a message) if upstream changed the code it expects.
#
# 1. Ubuntu Dock theming.js: a dock's Transparency stops working once that dock is destroyed. Without it, after a
#    monitor hotplug (HDMI) rebuilds the docks, leftover handlers of the old dock keep firing on every window move /
#    workspace switch and gnome-shell logs hundreds of
#      "Object Gjs_ubuntu-dock_ubuntu_com_docking_DashToDock (...), has been already disposed" stack traces.
# 2. AppIndicators settingsManager.js: the shell disables extensions while the screen is locked; tray icons that
#    update during that teardown called getDefaultGSettings() on a destroyed SettingsManager and threw
#      TypeError: can't access property "gsettings", SettingsManager.getDefault() is null
#    It now falls back to the last valid GSettings object.
# 3. Ubuntu Dock docking.js: on a fractionally scaled monitor (e.g. 166 %), the pointer at the very screen edge sits
#    in the last physical pixel row, which the dock's (whole-logical-pixel) area can miss. Whenever the window below
#    redraws (Firefox does constantly), the shell re-picks and the dock loses hover and hides with the pointer still
#    on the edge, or never shows at all. A pointer within 3 px of the screen edge, in line with the dock's icons
#    (or on the shown dock, 40 px beside it or 70 px above it), now counts as hovering; a watch reveals the hidden dock after show-delay
#    even if its strip never got hover, a pointer back on the icons during the hide delay cancels the hide
#    (the window below can get the pointer there), and a 100 ms check hides the dock once the pointer really leaves.
#    3b (battery): the watch used to tick every 150 ms forever, per dock (6-7 wakeups/s while idle). It now sleeps
#    until the pointer moves (cursor tracker 'position-invalidated', no events while it is still), the dock starts
#    hiding or its hover changes, and ticks only while it has something to do.
# 4. Ubuntu Dock docking.js: with the top bar hidden (hidetopbar) and the dock hidden, a maximized window covers the
#    whole monitor, so mutter unredirects it (direct scanout). The dock only blocked that for true fullscreen windows,
#    so over a maximized Firefox the screen kept switching between scanout and compositing as the dock appeared and
#    hid: the dock flickered and lost hover (it worked only while a notification, which blocks unredirection, was up).
#    The dock now blocks unredirection whenever it is on screen.
# 5. Ubuntu Dock docking.js: a fullscreen window on a fractionally scaled monitor (166 %) is scanned out with the
#    display hardware doing the scaling, which lands a few pixels off GNOME's own scaling: fullscreen Citrix/RustDesk
#    jumped up and left whenever the top bar or the dock appeared (GNOME composites again). Unredirection is now
#    blocked for fullscreen windows on fractionally scaled monitors (integer-scaled monitors keep direct scanout).
# 6. Desktop Icons (DING) fileItemMenu.js: an icon's right-click menu was attached to the desktop window and pointed
#    at the icon's allocation; it came out too short (cut off after a few items) and, at the right edge, did not fit.
#    It is now attached to the icon itself, like DING's rename popup, opens below it (flipped up near the bottom) so it
#    stays clear of the top bar, and points at the icon's inner third so it fits next to a screen edge.
import os
import shutil
import sys

EXT = "/usr/share/gnome-shell/extensions"
DOCK_MARK = "sb4edge-dock-fix"
APPIND_MARK = "sb4edge-appindicator-fix"
EDGE_MARK = "sb4edge-dock-edge-hover"
EDGE_EVENT_MARK = "sb4edge-dock-edge-event"
UNREDIR_MARK = "sb4edge-dock-unredirect"
FRAC_MARK = "sb4edge-dock-unredirect-fractional"
DING_MARK = "sb4edge-ding-menu-side"

# Patch 3b: texts as patch 3 leaves them (old) and their event-driven replacements (new).
EDGE_CTOR_OLD = """        this._edgeDwell = 0;
        this._edgeWatchId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 150, () => {
            this._edgeWatchTick();
            return GLib.SOURCE_CONTINUE;
        });
"""
EDGE_CTOR_NEW = """        this._edgeDwell = 0;
        // """ + EDGE_EVENT_MARK + """: no fixed polling; pointer motion, a hide or a hover change wakes the watch
        this._edgeWatchId = 0;
        this._cursorTracker = global.backend.get_cursor_tracker();
        this._cursorMovedId = this._cursorTracker.connect('position-invalidated', () => this._edgeWatchWake());
        this.connect('hiding', () => this._edgeWatchWake());
        this._box.connect('notify::hover', () => this._edgeWatchWake());
"""
EDGE_TICK_OLD = """    _edgeWatchTick() {
        const [, , mods] = global.get_pointer();
        const buttons = Clutter.ModifierType.BUTTON1_MASK | Clutter.ModifierType.BUTTON2_MASK |
            Clutter.ModifierType.BUTTON3_MASK;
        if (!this.autohideEnabled || this._ignoreHover || Main.overview.visibleTarget ||
            Main.modalCount > 0 || (mods & buttons) ||
            (!DockManager.settings.autohideInFullscreen && this._monitor?.inFullscreen)) {
            this._edgeDwell = 0;
            return;
        }
        // back on the icons during the hide delay: the dock is still drawn there but may not get hover
        // (the window below gets the pointer), so cancel the hide
        if (this.dockState === State.HIDING && this._pointerOnDock()) {
            this._show();
            this._pointerAtDockEdge();
            return;
        }
        if (this.dockState !== State.HIDDEN || !this._pointerAtDockEdgeNow()) {
            this._edgeDwell = 0;
            return;
        }
        this._edgeDwell += 150;
        if (this._edgeDwell < DockManager.settings.showDelay * 1000)
            return;
        this._edgeDwell = 0;
        this._show();
        this._pointerAtDockEdge();   // arms the check that hides it again once the pointer leaves
    }

"""
EDGE_TICK_NEW = """    // """ + EDGE_EVENT_MARK + """: true while the watch has something to do: the pointer on the hidden dock's
    // edge (show after show-delay), on the icons while the dock hides (cancel the hide), or on the shown dock
    // without hover (a hide is about to start)
    _edgeWatchNeeded() {
        const [, , mods] = global.get_pointer();
        const buttons = Clutter.ModifierType.BUTTON1_MASK | Clutter.ModifierType.BUTTON2_MASK |
            Clutter.ModifierType.BUTTON3_MASK;
        if (!this.autohideEnabled || this._ignoreHover || Main.overview.visibleTarget ||
            Main.modalCount > 0 || (mods & buttons) ||
            (!DockManager.settings.autohideInFullscreen && this._monitor?.inFullscreen))
            return false;
        if (this.dockState === State.HIDDEN)
            return this._pointerAtDockEdgeNow();
        if (this.dockState === State.HIDING)
            return this._pointerOnDock();
        if (this.dockState === State.SHOWN)
            return !this._box?.hover && this._pointerOnDock();
        return false;
    }

    _edgeWatchWake() {
        if (this._edgeWatchId || !this._box || !this._edgeWatchNeeded())
            return;
        this._edgeWatchId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 150, () => {
            if (this._edgeWatchTick())
                return GLib.SOURCE_CONTINUE;
            this._edgeWatchId = 0;
            this._edgeDwell = 0;
            return GLib.SOURCE_REMOVE;
        });
    }

    // returns whether to keep ticking
    _edgeWatchTick() {
        if (!this._edgeWatchNeeded())
            return false;
        // back on the icons during the hide delay: the dock is still drawn there but may not get hover
        // (the window below gets the pointer), so cancel the hide
        if (this.dockState === State.HIDING) {
            this._show();
            this._pointerAtDockEdge();
            return false;
        }
        if (this.dockState !== State.HIDDEN)
            return true;   // shown without hover: wait for the hide to start
        this._edgeDwell += 150;
        if (this._edgeDwell < DockManager.settings.showDelay * 1000)
            return true;
        this._edgeDwell = 0;
        this._show();
        this._pointerAtDockEdge();   // arms the check that hides it again once the pointer leaves
        return false;
    }

"""
EDGE_DESTROY_OLD = """        if (this._edgeWatchId)
            GLib.source_remove(this._edgeWatchId);
        this._edgeWatchId = 0;
"""
EDGE_DESTROY_NEW = EDGE_DESTROY_OLD + """        if (this._cursorMovedId)
            this._cursorTracker.disconnect(this._cursorMovedId);
        this._cursorMovedId = 0;
"""

PATCHES = [
    (f"{EXT}/ubuntu-dock@ubuntu.com/theming.js", DOCK_MARK, [
        # Transparency constructor: watch our own dock's destruction
        ("        this._signalsHandler = new Utils.GlobalSignalsHandler();\n        this._trackedWindows = new Map();\n",
         "        this._signalsHandler = new Utils.GlobalSignalsHandler();\n        this._trackedWindows = new Map();\n"
         "        // " + DOCK_MARK + ": never touch this dock again once it is destroyed\n"
         "        this._destroyed = false;\n"
         "        dock.connect('destroy', () => this.destroy());\n"),
        ("    enable() {\n        // ensure I never double-register/inject\n",
         "    enable() {\n        if (this._destroyed)\n            return;\n        // ensure I never double-register/inject\n"),
        ("    destroy() {\n        this.disable();\n        this._signalsHandler.destroy();\n    }\n",
         "    destroy() {\n        if (this._destroyed)\n            return;\n        this._destroyed = true;\n"
         "        this.disable();\n        this._signalsHandler.destroy();\n    }\n"),
        ("    _onWindowActorAdded(container, metaWindowActor) {\n",
         "    _onWindowActorAdded(container, metaWindowActor) {\n        if (this._destroyed)\n            return;\n"
         "        this._trackedWindows.get(metaWindowActor)?.forEach(id => metaWindowActor.disconnect(id));\n"),
        ("    _updateSolidStyle() {\n",
         "    _updateSolidStyle() {\n        if (this._destroyed)\n            return;\n"),
    ]),
    (f"{EXT}/ubuntu-appindicators@ubuntu.com/settingsManager.js", APPIND_MARK, [
        ("let settingsManager;\n",
         "let settingsManager;\n"
         "// " + APPIND_MARK + ": last valid GSettings, used while the manager is torn down (screen lock)\n"
         "let lastGSettings = null;\n"),
        ("        this._gsettings = extension.getSettings();\n",
         "        this._gsettings = extension.getSettings();\n        lastGSettings = this._gsettings;\n"),
        ("    return SettingsManager.getDefault().gsettings;\n",
         "    return SettingsManager.getDefault()?.gsettings ?? lastGSettings;\n"),
    ]),
    (f"{EXT}/ubuntu-dock@ubuntu.com/docking.js", EDGE_MARK, [
        ("                if (this._box.hover || Main.overview.visible)\n",
         "                if (this._box.hover || Main.overview.visible || this._pointerAtDockEdge())\n"),
        ("        this._box.connect('notify::hover', this._hoverChanged.bind(this));\n",
         "        this._box.connect('notify::hover', this._hoverChanged.bind(this));\n"
         "        // " + EDGE_MARK + ": reveal the hidden dock even when its strip never gets hover\n"
         "        this._edgeDwell = 0;\n"
         "        this._edgeWatchId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 150, () => {\n"
         "            this._edgeWatchTick();\n"
         "            return GLib.SOURCE_CONTINUE;\n"
         "        });\n"),
        ("    _show() {\n",
         "    // " + EDGE_MARK + ": see /usr/lib/sb4edge/sb4edge-dock-fix (fractional scaling edge row)\n"
         "    _pointerAtDockEdge() {\n"
         "        const m = this._monitor;\n"
         "        if (!m || !this._box)\n"
         "            return false;\n"
         "        const [x, y] = global.get_pointer();\n"
         "        const [bx, by] = this._box.get_transformed_position();\n"
         "        const [bw, bh] = this._box.get_transformed_size();\n"
         "        const EDGE = 3, MARGIN = 40, ABOVE = 70;\n"
         "        let atEdge;\n"
         "        if (this._position === St.Side.BOTTOM)\n"
         "            atEdge = y >= m.y + m.height - EDGE && x >= bx && x < bx + bw;\n"
         "        else if (this._position === St.Side.TOP)\n"
         "            atEdge = y < m.y + EDGE && x >= bx && x < bx + bw;\n"
         "        else if (this._position === St.Side.LEFT)\n"
         "            atEdge = x < m.x + EDGE && y >= by && y < by + bh;\n"
         "        else\n"
         "            atEdge = x >= m.x + m.width - EDGE && y >= by && y < by + bh;\n"
         "        // a shown dock stays up while the pointer is on it, within MARGIN px beside it or ABOVE px over it (a re-pick can lose\n"
         "        // hover, and a touchpad finger lifting off often jumps the pointer 15-50 px up off the icons)\n"
         "        if (!atEdge && (this.dockState === State.SHOWN || this.dockState === State.SHOWING)) {\n"
         "            if (this._position === St.Side.BOTTOM)\n"
         "                atEdge = x >= bx - MARGIN && x < bx + bw + MARGIN && y >= by - ABOVE && y < m.y + m.height;\n"
         "            else if (this._position === St.Side.TOP)\n"
         "                atEdge = x >= bx - MARGIN && x < bx + bw + MARGIN && y >= m.y && y < by + bh + ABOVE;\n"
         "            else if (this._position === St.Side.LEFT)\n"
         "                atEdge = y >= by - MARGIN && y < by + bh + MARGIN && x >= m.x && x < bx + bw + ABOVE;\n"
         "            else\n"
         "                atEdge = y >= by - MARGIN && y < by + bh + MARGIN && x >= bx - ABOVE && x < m.x + m.width;\n"
         "        }\n"
         "        if (atEdge && !this._edgeHoverId) {\n"
         "            this._edgeHoverId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 100, () => {\n"
         "                if (this._box?.hover || this._pointerAtDockEdgeNow())\n"
         "                    return GLib.SOURCE_CONTINUE;\n"
         "                this._edgeHoverId = 0;\n"
         "                this._hoverChanged();\n"
         "                return GLib.SOURCE_REMOVE;\n"
         "            });\n"
         "        }\n"
         "        return atEdge;\n"
         "    }\n\n"
         "    _pointerAtDockEdgeNow() {\n"
         "        const id = this._edgeHoverId;\n"
         "        this._edgeHoverId = -1;   // no new timer from this check\n"
         "        const r = this._pointerAtDockEdge();\n"
         "        this._edgeHoverId = id;\n"
         "        return r;\n"
         "    }\n\n"
         "    _pointerOnDock() {\n"
         "        const m = this._monitor;\n"
         "        if (!m || !this._box)\n"
         "            return false;\n"
         "        const [x, y] = global.get_pointer();\n"
         "        const [bx, by] = this._box.get_transformed_position();\n"
         "        const [bw, bh] = this._box.get_transformed_size();\n"
         "        if (this._position === St.Side.BOTTOM)\n"
         "            return x >= bx && x < bx + bw && y >= by && y < m.y + m.height;\n"
         "        if (this._position === St.Side.TOP)\n"
         "            return x >= bx && x < bx + bw && y >= m.y && y < by + bh;\n"
         "        if (this._position === St.Side.LEFT)\n"
         "            return y >= by && y < by + bh && x >= m.x && x < bx + bw;\n"
         "        return y >= by && y < by + bh && x >= bx && x < m.x + m.width;\n"
         "    }\n\n"
         "    _edgeWatchTick() {\n"
         "        const [, , mods] = global.get_pointer();\n"
         "        const buttons = Clutter.ModifierType.BUTTON1_MASK | Clutter.ModifierType.BUTTON2_MASK |\n"
         "            Clutter.ModifierType.BUTTON3_MASK;\n"
         "        if (!this.autohideEnabled || this._ignoreHover || Main.overview.visibleTarget ||\n"
         "            Main.modalCount > 0 || (mods & buttons) ||\n"
         "            (!DockManager.settings.autohideInFullscreen && this._monitor?.inFullscreen)) {\n"
         "            this._edgeDwell = 0;\n"
         "            return;\n"
         "        }\n"
         "        // back on the icons during the hide delay: the dock is still drawn there but may not get hover\n"
         "        // (the window below gets the pointer), so cancel the hide\n"
         "        if (this.dockState === State.HIDING && this._pointerOnDock()) {\n"
         "            this._show();\n"
         "            this._pointerAtDockEdge();\n"
         "            return;\n"
         "        }\n"
         "        if (this.dockState !== State.HIDDEN || !this._pointerAtDockEdgeNow()) {\n"
         "            this._edgeDwell = 0;\n"
         "            return;\n"
         "        }\n"
         "        this._edgeDwell += 150;\n"
         "        if (this._edgeDwell < DockManager.settings.showDelay * 1000)\n"
         "            return;\n"
         "        this._edgeDwell = 0;\n"
         "        this._show();\n"
         "        this._pointerAtDockEdge();   // arms the check that hides it again once the pointer leaves\n"
         "    }\n\n"
         "    _show() {\n"),
        ("    _onDestroy() {\n",
         "    _onDestroy() {\n"
         "        if (this._edgeHoverId > 0)\n"
         "            GLib.source_remove(this._edgeHoverId);\n"
         "        this._edgeHoverId = 0;\n"
         "        if (this._edgeWatchId)\n"
         "            GLib.source_remove(this._edgeWatchId);\n"
         "        this._edgeWatchId = 0;\n"),
    ]),
    # applies on top of EDGE_MARK (installed systems already have it)
    (f"{EXT}/ubuntu-dock@ubuntu.com/docking.js", EDGE_EVENT_MARK, [
        (EDGE_CTOR_OLD, EDGE_CTOR_NEW),
        (EDGE_TICK_OLD, EDGE_TICK_NEW),
        (EDGE_DESTROY_OLD, EDGE_DESTROY_NEW),
    ]),
    (f"{EXT}/ubuntu-dock@ubuntu.com/docking.js", UNREDIR_MARK, [
        ("        case State.SHOWN:\n            return !!this._monitor?.inFullscreen;\n",
         "        case State.SHOWN:\n"
         "            // " + UNREDIR_MARK + ": also over maximized windows that cover the monitor (see sb4edge-dock-fix)\n"
         "            return true;\n"),
    ]),
    (f"{EXT}/ubuntu-dock@ubuntu.com/docking.js", FRAC_MARK, [
        ("        if (!this.visible)\n            return false;\n\n        switch (this.dockState) {\n",
         "        // " + FRAC_MARK + ": a fullscreen window on a fractionally scaled monitor is never scanned out\n"
         "        // directly: the display hardware's scaling lands a few pixels off GNOME's (see sb4edge-dock-fix)\n"
         "        if (this._monitor?.inFullscreen && this._monitor.geometry_scale % 1 !== 0)\n"
         "            return true;\n"
         "        if (!this.visible)\n            return false;\n\n        switch (this.dockState) {\n"),
    ]),
    (f"{EXT}/ding@rastersoft.com/app/fileItemMenu.js", DING_MARK, [
        ("        menuPopover.set_parent(grid.Window);\n        menuPopover.set_pointing_to(fileItem.container.get_allocation());\n",
         "        // " + DING_MARK + ": attached to the icon itself, like the rename popup (attached to the window and\n"
         "        // pointed at the icon's allocation, the menu came out too short and was cut off; see sb4edge-dock-fix);\n"
         "        // below the icon (GTK flips it up near the bottom), so it never reaches under the top bar\n"
         "        menuPopover.set_parent(fileItem.container);\n"
         "        {   // point at the inner third of the icon: centred on an icon at a screen edge the menu would not fit\n"
         "            const w = fileItem.container.get_width(), h = fileItem.container.get_height();\n"
         "            const third = Math.max(1, Math.round(w / 3));\n"
         "            const rect = new Gdk.Rectangle({x: fileItem.relativeX > 0.5 ? 0 : w - third, y: 0, width: third, height: h});\n"
         "            menuPopover.set_pointing_to(rect);\n"
         "        }\n"),
    ]),
]


def apply(path, mark, edits):
    try:
        src = open(path, encoding="utf-8").read()
    except FileNotFoundError:
        return
    if mark in src:
        return
    name = os.path.basename(path)
    for old, new in edits:
        if src.count(old) != 1:
            print(f"{mark}: {name} layout changed, not patching (looked for: {old.strip().splitlines()[0]!r})",
                  file=sys.stderr)
            return
        src = src.replace(old, new)
    tmp = path + ".sb4edge-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(src)
    shutil.copymode(path, tmp)
    os.replace(tmp, path)
    print(f"{mark}: patched {path} (takes effect at next login)")


for path, mark, edits in PATCHES:
    apply(path, mark, edits)
