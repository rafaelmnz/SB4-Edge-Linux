# Extensions enabled by default. Ubuntu's own extensions (dock, desktop icons, tiling assistant) are enabled by the
# ubuntu session mode, not by this key. The others are installed system-wide by remaster.sh from overlay/gnome:
#   display-brightness-ddcutil  external monitor brightness (DDC/CI) in the system menu
#   hidetopbar-multimonitor     auto-hiding top bar on every monitor (sb4edge fixes: desktop icons kept below the
#                               secondary panels; overview search spacing at fractional scaling)
#   top-bar-organizer-plus      reorder top bar items
#   simple-weather              weather in the top bar
#   sb4edge-tweaks-xr           sb4edge's own tweaks in one extension, each switchable in its preferences:
#                               screenshot UI without the selection box, OCR (text) from a screen area (needs
#                               tesseract-ocr), Esc / empty-space click closes the overview and a click on a
#                               neighbouring workspace switches to it, RustDesk window locator, cleanup after
#                               hidetopbar's extra top bars, accessibility icon only with "Always Show" (also while
#                               Large Text is on, on every top bar). Listed before hidetopbar: GNOME enables in this
#                               order and disables in reverse at lock, so the cleanup sees every extra top bar.
# snapd-search-provider (Ubuntu, declares GNOME 48-49) is disabled: on GNOME 51 it broke Esc in the overview search.
[org.gnome.shell]
enabled-extensions=['display-brightness-ddcutil@themightydeity.github.com', 'sb4edge-tweaks-xr@sb4edge', 'hidetopbar-multimonitor@linuxitos.local', 'top-bar-organizer-plus@shibasishpaul.github.com', 'simple-weather@romanlefler.com']
disabled-extensions=['snapd-search-provider@canonical.com']
