[Unit]
Description=Report (or with AUTO_IMPORT=yes, import) fingerprints enrolled in Windows Hello
# Before the login screen, so with AUTO_IMPORT=yes a finger enrolled in Windows works at the first login after it.
Before=display-manager.service
After=systemd-udev-settle.service dbus.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/sb4edge-fingerprint-import --auto
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
