#!/usr/bin/python3
"""Use fingerprints enrolled in Windows Hello for Linux login too.

The EgisTec sensor keeps prints on the chip, shared by Windows and Linux. A print enrolled in Linux is unknown to
Windows (Windows Hello keeps its own database), and enrolling the same finger in Linux makes fprintd delete the
Windows print (its duplicate check removes on-chip prints it does not know). So: enroll in Windows Hello, and this
records chip prints not yet known to fprintd as fingers of a Linux user. Nothing is written to the sensor.

Windows Hello prints carry no owner on the chip, so a print is only given to a Linux user after that user touches the
sensor with that finger (the sensor identifies which of the new prints it is):

  sudo sb4edge-fingerprint-import [user] [finger]   touch the sensor: your new Windows Hello print -> that finger
                                                    (default: you, the next free finger from right-index on)
  sudo sb4edge-fingerprint-import --list            prints on the sensor, and which Linux finger each one is
  sudo sb4edge-fingerprint-import --rename FROM TO [user]
                                                    relabel a print, e.g. right-index left-index (Windows Hello
                                                    numbers its prints 1, 2, 3 and never says which finger).
  sb4edge-fingerprint-import --auto                 at boot (sb4edge-fingerprint-import.service): reports new prints;
                                                    imports them without a touch only with AUTO_IMPORT=yes
  sb4edge-fingerprint-import --pam                  --auto in the background, for pam_exec (does not delay login)

AUTO_IMPORT=yes in /etc/default/sb4edge-fingerprint brings back the touch-free import (every new print -> the only
regular user). Only for a laptop where nobody else has a Windows Hello fingerprint: a finger someone enrolled in
their own Windows account would unlock this Linux account, sudo included.
"""
import glob, os, pwd, subprocess, sys, time
import gi
gi.require_version('FPrint', '2.0')
from gi.repository import FPrint, GLib

FINGERS = {FPrint.Finger(i).value_nick: FPrint.Finger(i) for i in range(1, 11)}
AUTO_ORDER = ['right-index', 'left-index', 'right-middle', 'left-middle', 'right-thumb', 'left-thumb',
              'right-ring', 'left-ring', 'right-little', 'left-little']
STORE = '/var/lib/fprint'
CONFIG = '/etc/default/sb4edge-fingerprint'
TOUCH_TIMEOUT = 30


def auto_import_enabled():
    try:
        for line in open(CONFIG):
            k, _, v = line.strip().partition('=')
            if k.strip() == 'AUTO_IMPORT':
                return v.strip().strip('"\'').lower() in ('yes', 'true', '1')
    except OSError:
        pass
    return False


def identify(dev, prints):
    """Wait for a finger and return which of prints it is (None: another finger, or no touch in time)."""
    import threading
    from gi.repository import Gio
    cancel = Gio.Cancellable()
    timer = threading.Timer(TOUCH_TIMEOUT, cancel.cancel)
    timer.start()
    try:
        res = dev.identify_sync(prints, cancel, None, None)
    except Exception as e:
        if cancel.is_cancelled():
            sys.exit(f'no finger within {TOUCH_TIMEOUT} s: nothing imported')
        sys.exit(f'the sensor could not read the finger ({e}): nothing imported')
    finally:
        timer.cancel()
    match = res[0] if isinstance(res, tuple) else res
    return next((p for p in prints if match is not None and p.equal(match)), None)


def log(msg):
    print(msg, flush=True)


def regular_users():
    return [u.pw_name for u in pwd.getpwall()
            if 1000 <= u.pw_uid < 60000 and not u.pw_shell.endswith(('nologin', 'false'))]


def stored_prints(dev):
    """Prints fprintd stores for this device: [(user, finger number, print)]."""
    out = []
    for f in glob.glob(f'{STORE}/*/{dev.get_driver()}/{dev.get_device_id()}/*'):
        try:
            out.append((f.split('/')[-4], int(os.path.basename(f)), FPrint.Print.deserialize(open(f, 'rb').read())))
        except Exception:
            pass
    return out


def save(dev, p, user, nick):
    p.set_finger(FINGERS[nick])
    p.set_username(user)
    d = f'{STORE}/{user}/{dev.get_driver()}/{dev.get_device_id()}'
    os.makedirs(d, mode=0o700, exist_ok=True)
    path = f'{d}/{int(FINGERS[nick])}'
    with open(path, 'wb') as f:
        f.write(p.serialize())
    os.chmod(path, 0o600)
    log(f'{nick}-finger of {user} now uses a print enrolled in Windows Hello')


def rename(src=None, dst=None, user=None):
    """Relabel a stored print as another finger. Only fprintd's files change; the print on the chip stays."""
    user = user or os.environ.get('SUDO_USER') or sys.exit('no user given')
    pwd.getpwnam(user)
    src, dst = (f and f.removesuffix('-finger') for f in (src, dst))
    if src not in FINGERS or dst not in FINGERS:
        sys.exit('usage: sudo sb4edge-fingerprint-import --rename FROM TO [user]\nfingers: ' + ' '.join(FINGERS))
    if src == dst:
        return
    srcs = glob.glob(f'{STORE}/{user}/*/*/{int(FINGERS[src])}')
    if not srcs:
        sys.exit(f'{user} has no {src} print')
    for old in srcs:
        new = f'{os.path.dirname(old)}/{int(FINGERS[dst])}'
        if os.path.exists(new):
            sys.exit(f'{user} already has a {dst} print: rename or delete that one first')
        p = FPrint.Print.deserialize(open(old, 'rb').read())
        p.set_finger(FINGERS[dst])
        with open(new, 'wb') as f:
            f.write(p.serialize())
        os.chmod(new, 0o600)
        os.remove(old)
    # No fprintd restart: it reads its store on every ListEnrolledFingers, and a restart would break an open
    # Settings fingerprint dialog (it holds the device).
    log(f'{src}-finger of {user} is now {dst}-finger')


def open_device():
    """fprintd holds the sensor while it runs; it is D-Bus activated and comes back on its own when needed."""
    ctx = FPrint.Context()
    for attempt in range(5):
        subprocess.run(['systemctl', 'stop', 'fprintd'], check=False)
        devs = ctx.get_devices()
        if not devs:   # at boot the USB device may not be there yet
            time.sleep(2)
            ctx = FPrint.Context()
            continue
        try:
            devs[0].open_sync()
            return ctx, devs[0]   # keep ctx alive: the devices die with the context
        except Exception as e:
            log(f'sensor busy ({e}), retrying')
            time.sleep(2)
    return ctx, None


def main():
    if os.geteuid() != 0:
        sys.exit('run with sudo')
    args = sys.argv[1:]
    mode = args[0] if args[:1] and args[0] in ('--list', '--auto', '--pam', '--rename') else 'manual'

    if mode == '--rename':
        rename(*args[1:])
        return

    if mode == '--pam':
        # pam_exec waits for us: detach and let the login continue.
        if os.environ.get('PAM_TYPE') not in (None, 'open_session'):
            return
        # Only desktop logins: ssh, su, sudo, cron sessions must not touch the sensor (opening it resets its USB link).
        if os.environ.get('PAM_SERVICE', '') not in ('', 'gdm-password', 'gdm-fingerprint', 'gdm-autologin',
                                                    'login', 'sddm', 'lightdm'):
            return
        if os.fork():
            return
        os.setsid()
        if os.fork():
            os._exit(0)
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        time.sleep(3)   # let GDM release the sensor after a fingerprint login
        os.execv('/usr/bin/systemd-cat', ['systemd-cat', '-t', 'sb4edge-fingerprint-import',
                                          sys.executable, os.path.abspath(__file__), '--auto'])

    if mode == '--auto':
        users = regular_users()
        if len(users) != 1:
            log(f'{len(users)} regular users: not importing automatically (use: sudo {sys.argv[0]} <user> <finger>)')
            return
        user, nick = users[0], None
    elif mode == 'manual':
        user = (args[0] if args else os.environ.get('SUDO_USER')) or sys.exit('no user given')
        nick = args[1].removesuffix('-finger') if len(args) > 1 else None
        pwd.getpwnam(user)
        if nick is not None and nick not in FINGERS:
            sys.exit('finger must be one of: ' + ' '.join(FINGERS))

    ctx, dev = open_device()
    if not dev:
        sys.exit('no fingerprint reader available') if mode != '--auto' else log('no fingerprint reader available')
        return
    try:
        on_chip = dev.list_prints_sync()
        stored = stored_prints(dev)
        new = [p for p in on_chip if not any(p.equal(s[2]) for s in stored)]
        log(f'{len(on_chip)} print(s) on the sensor, {len(on_chip) - len(new)} already used by Linux, {len(new)} new')
        if mode == '--list':
            for i, p in enumerate(on_chip, 1):
                who = [f'{u} {FPrint.Finger(n).value_nick}' for u, n, sp in stored if p.equal(sp)]
                log(f'  print {i}: ' + (', '.join(who) if who else 'not used by Linux'))
            return
        used = {n for u, n, _ in stored if u == user}
        free = [f for f in AUTO_ORDER if int(FINGERS[f]) not in used]
        if mode == 'manual':
            if not new:
                sys.exit('no Windows Hello print that Linux does not use yet: enroll the finger in Windows Hello first')
            if nick is None:
                nick = free[0] if free else sys.exit(f'{user} has no free finger left: give one, e.g. right-index')
            elif int(FINGERS[nick]) in used:
                sys.exit(f'{user} already has a {nick} print: pick another finger, or rename/delete that one first')
            log(f'Touch the sensor with the finger you enrolled in Windows Hello (rest it, do not press), '
                f'within {TOUCH_TIMEOUT} s...')
            p = identify(dev, new)
            if p is None:
                sys.exit('that finger is not one of the new Windows Hello prints: nothing imported')
            save(dev, p, user, nick)
            return
        if not new:
            return
        if not auto_import_enabled():
            log(f'{len(new)} Windows Hello print(s) not used by Linux yet; to use yours, run '
                f'"sudo sb4edge-fingerprint-import" and touch the sensor (or set AUTO_IMPORT=yes in {CONFIG})')
            return
        for p, f in zip(new, free):
            save(dev, p, user, f)
        if len(new) > len(free):
            log('no free finger slots left for the remaining prints')
    finally:
        try:
            dev.close_sync()
        except GLib.Error:
            pass             # the reader already went away (suspend, shutdown, USB reset)


# Leave without Python's object teardown: freeing the libfprint/GUsb device during interpreter shutdown crashed in
# libusb_unref_device (SIGBUS) after the work was already done, which left a crash report at every boot that ran it.
try:
    main()
    code = 0
except SystemExit as e:
    code = e.code
except GLib.Error as e:
    # The reader can disappear mid-read (suspend, shutdown, USB reset): report it instead of filing a crash report.
    print(f'fingerprint reader error: {e.message}', file=sys.stderr)
    code = 0 if {'--auto', '--pam'} & set(sys.argv[1:]) else 1
if not isinstance(code, int):
    if code is not None:
        print(code, file=sys.stderr)
    code = 0 if code is None else 1
sys.stdout.flush()
sys.stderr.flush()
os._exit(code)
