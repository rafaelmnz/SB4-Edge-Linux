#!/bin/sh
# sb4edge: the Windows system drive is mounted read-only; folders are made writable one by one.
#
#   sb4edge-windows-mount start               mount read-only, re-apply the unlocked folders (boot service)
#   sb4edge-windows-mount stop                unmount everything
#   sb4edge-windows-mount unlock-folder PATH  make PATH and everything under it writable (kept across reboots)
#   sb4edge-windows-mount lock-folder PATH    make it read-only again
#   sb4edge-windows-mount rename-folder PATH NEWNAME / delete-folder PATH
#                                             rename / permanently delete an unlocked folder itself (its entry is
#                                             in the locked parent, so Files can't); it stays unlocked when renamed
#   sb4edge-windows-mount status
# unlock-folder/lock-folder run through pkexec (password prompt); GNOME Files offers them in the right-click menu
# ("Unlock folder" / "Lock folder", nautilus-python extension sb4edge-unlock-folder.py). The unlocked folders are
# remembered in /var/lib/sb4edge/windows-unlocked (one path per line, relative to the volume root).
#
# The drive is found automatically: the NTFS volume holding Windows/System32 (BitLocker volumes count once
# sb4edge-windows-unlock has opened them at boot; a volume you unlock later in Files mounts normally, writable).
# It shows in Files for the first user account. /etc/default/sb4edge-windows-mount can set
#   ENABLED=no        mount Windows drives the normal way (writable), no Lock/Unlock folder
#   UUID=...          the NTFS volume to use (filesystem UUID, see lsblk -f)
#   USER_NAME=...     whose Files shows it (/run/media/USER_NAME/UUID)
#
# How: ntfs-3g mounts the volume read-write at $RW (root-only, not reachable by users); $MAIN (the /run/media path
# Files shows as the drive) is a read-only bind of it, and each unlocked folder is a read-write mount on top, hidden
# from the Files sidebar (x-gvfs-hide); it is a bindfs mount so it has its own device number (GNOME's file layer
# judges read-only by device). A hibernated Windows (Fast Startup) is mounted read-only as a whole.
set -u
ENABLED=yes
UUID=
USER_NAME=
[ -r /etc/default/sb4edge-windows-mount ] && . /etc/default/sb4edge-windows-mount
[ -n "$USER_NAME" ] || USER_NAME=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ {print $1; exit}')
STATE=/run/sb4edge/windows-uuid   # the volume chosen at start, for the other commands
[ -n "$UUID" ] || [ ! -r "$STATE" ] || UUID=$(cat "$STATE")

find_windows() {   # print the filesystem UUID of the NTFS volume that holds Windows/System32
	probe=/run/sb4edge/probe
	mkdir -p /run/sb4edge "$probe" && chmod 700 /run/sb4edge
	for d in $(blkid -t TYPE=ntfs -o device 2>/dev/null); do
		u=$(blkid -s UUID -o value "$d") || continue
		m=$(findmnt -rn -S "$d" -o TARGET | head -1)
		if [ -n "$m" ]; then
			[ -d "$m/Windows/System32" ] && { echo "$u"; return 0; }
			continue
		fi
		mount -t ntfs-3g -o ro "$d" "$probe" 2>/dev/null || continue
		found=no; [ -d "$probe/Windows/System32" ] && found=yes
		umount "$probe"
		[ $found = yes ] && { echo "$u"; return 0; }
	done
	return 1
}

RW=/run/sb4edge/windows-rw
MAIN=/run/media/$USER_NAME/$UUID
LIST=/var/lib/sb4edge/windows-unlocked     # one path per line, relative to the volume root (readable by all: the
                                           # Files menu reads it to offer Lock or Unlock)
log() { echo "sb4edge-windows-mount: $*"; logger -t sb4edge-windows-mount -- "$*" 2>/dev/null || true; }
mounted() { mountpoint -q "$1" 2>/dev/null; }
hibernated() { findmnt -no OPTIONS "$RW" 2>/dev/null | grep -qw ro; }

mount_targets() {   # every mount point, one per line, with the kernel's octal escapes (spaces...) decoded
	awk '{print $5}' /proc/self/mountinfo | sed 's/\\040/ /g; s/\\011/\t/g; s/\\012/\n/g; s/\\134/\\/g'
}

ALIASES=/run/sb4edge/unlocked
alias_of() { echo "$ALIASES/$(printf %s "$1" | sha1sum | cut -c1-16)"; }
unalias_unused() {   # drop alias mounts whose folder is no longer unlocked
	[ -d "$ALIASES" ] || return 0
	for a in "$ALIASES"/*; do
		[ -d "$a" ] || continue
		awk '{for (i = 7; i <= NF; i++) if ($i == "-") { print $(i + 2); break }}' /proc/self/mountinfo | grep -qxF "$a" && continue
		mounted "$a" && umount "$a" 2>/dev/null; rmdir "$a" 2>/dev/null
	done
	return 0
}

notify_files() {   # notify_files REL: make file managers re-read the folder's (now changed) writability
	# Unlocking/locking only changes the mount over the folder, not the folder itself, so GNOME Files gets no change
	# event, keeps its cached read-only state (no "New Folder") and could crash on the stale view. Touching the
	# folder through the root-only read-write mount (same inode) and putting its time back sends that event.
	d="$RW/$1"; [ "$1" = . ] && d="$RW"
	t=$(stat -c %.9Y "$d" 2>/dev/null) || return 0
	touch -c "$d" 2>/dev/null && touch -c -m -d "@$t" "$d" 2>/dev/null
	return 0
}

bind_rw() {   # bind_rw REL
	if [ "$1" = . ]; then   # the whole volume
		mount -o remount,bind,rw,nosuid,nodev "$MAIN" && log "unlocked: whole volume"; return
	fi
	[ -d "$RW/$1" ] || { log "not a folder on the volume: $1"; return 1; }
	mounted "$MAIN/$1" && return 0
	# bindfs (its own FUSE filesystem), not mount --bind: a bind mount keeps the read-only drive's device number,
	# so GIO/GNOME Files took the folder for read-only ("destination is read-only", then Files crashed)
	# bindfs reads the folder through a hidden alias without spaces: with a space in its source path bindfs records
	# its source as just "bindfs", the x-gvfs-hide flag (kept by path) no longer matches, and Files showed the
	# folder as a mount it offered to "unmount"
	a=$(alias_of "$1"); mkdir -p "$a"
	mounted "$a" || { mount --bind "$RW/$1" "$a" && mount --make-private "$a"; } || return 1
	mount -t fuse.bindfs -o allow_other,x-gvfs-hide "$a" "$MAIN/$1" && log "unlocked: $1"
}

start() {
	[ "$ENABLED" = yes ] || { log "disabled in /etc/default/sb4edge-windows-mount"; exit 0; }
	[ -n "$USER_NAME" ] || { log "no user account yet"; exit 0; }
	[ -n "$UUID" ] || UUID=$(find_windows) || { log "no Windows volume found (BitLocker still locked?)"; exit 0; }
	MAIN=/run/media/$USER_NAME/$UUID
	d=$(blkid -U "$UUID" 2>/dev/null)
	[ -n "$d" ] || { log "volume $UUID not present (BitLocker still locked?)"; exit 0; }
	mounted "$MAIN" && { log "already mounted"; exit 0; }
	uid=$(id -u "$USER_NAME") gid=$(id -g "$USER_NAME")
	mkdir -p /run/sb4edge && chmod 700 /run/sb4edge
	mkdir -p "$RW" "$MAIN"
	opts="uid=$uid,gid=$gid,umask=022,windows_names,nosuid,nodev"
	if ! mount -t ntfs-3g -o "$opts" "$d" "$RW" 2>/tmp/sb4edge-ntfs-err; then
		log "read-write mount refused ($(tr '\n' ' ' </tmp/sb4edge-ntfs-err)); mounting read-only"
		mount -t ntfs-3g -o "ro,$opts" "$d" "$RW" || { log "mount failed"; exit 1; }
	fi
	mount --make-private "$RW"   # the binds below must not propagate back into $RW
	mount --bind "$RW" "$MAIN"
	mount -o remount,bind,ro,nosuid,nodev "$MAIN"
	if hibernated; then
		log "Windows is hibernated: the whole volume stays read-only"
	elif [ -r "$LIST" ]; then
		while IFS= read -r p; do [ -n "$p" ] && bind_rw "$p"; done < "$LIST"
	fi
	echo "$UUID" > "$STATE"
	log "mounted $d at $MAIN (read-only, unlocked folders writable)"
}

stop() {
	mount_targets | grep -E "^($MAIN|$RW)/" | sort -r | while IFS= read -r m; do umount "$m" || umount -l "$m"; done
	mounted "$MAIN" && { umount "$MAIN" || umount -l "$MAIN"; }
	unalias_unused
	mounted "$RW" && umount "$RW"
	rm -f "$STATE"
	log "unmounted"
}

rel_of() {    # rel_of PATH: path relative to the volume root, or fail
	p=$(realpath -m -- "$1") || return 1
	case "$p" in
	"$MAIN") echo . ;;
	"$MAIN"/*) echo "${p#"$MAIN"/}" ;;
	*) return 1 ;;
	esac
}

unlock_folder() {
	mounted "$MAIN" || { log "the Windows volume is not mounted"; exit 1; }
	hibernated && { log "Windows is hibernated (Fast Startup): the volume stays read-only"; exit 1; }
	r=$(rel_of "${1:-}") || { log "not on the Windows volume: ${1:-}"; exit 2; }
	bind_rw "$r" || exit 1
	notify_files "$r"
	mkdir -p "$(dirname "$LIST")"; touch "$LIST"
	grep -qxF -- "$r" "$LIST" || printf '%s\n' "$r" >> "$LIST"
	chmod 644 "$LIST"
}

lock_folder() {
	r=$(rel_of "${1:-}") || { log "not on the Windows volume: ${1:-}"; exit 2; }
	# folders unlocked inside it go too
	mount_targets | grep -E "^$MAIN/" | sort -r | while IFS= read -r m; do
		case "$m" in "$MAIN/$r"|"$MAIN/$r"/*) umount "$m" 2>/dev/null || { log "busy, try again: $m"; exit 1; } ;; esac
	done || exit 1
	if [ -f "$LIST" ]; then
		awk -v r="$r" '$0 != r && index($0, r "/") != 1' "$LIST" > "$LIST.new" && mv "$LIST.new" "$LIST"
	fi
	[ "$r" = . ] && mount -o remount,bind,ro,nosuid,nodev "$MAIN"
	unalias_unused
	notify_files "$r"
	log "locked: $r"
}

unlock_point() {   # unlock_point PATH: print REL if PATH is itself an unlocked folder (not the drive root)
	r=$(rel_of "${1:-}") || { log "not on the Windows volume: ${1:-}" >&2; exit 2; }
	[ "$r" != . ] && [ -f "$LIST" ] && grep -qxF -- "$r" "$LIST" || { log "not an unlocked folder: $r" >&2; exit 2; }
	echo "$r"
}

unmount_tree() {   # unmount_tree REL: unmount the folder and anything unlocked inside it
	mount_targets | grep -E "^$MAIN/" | sort -r | while IFS= read -r m; do
		case "$m" in "$MAIN/$1"|"$MAIN/$1"/*) umount "$m" 2>/dev/null || { log "in use, close what uses it and try again: $m"; exit 1; } ;; esac
	done || return 1
	unalias_unused
}

remount_tree() {   # remount_tree REL: unlock again every listed folder at or inside REL
	while IFS= read -r p; do
		case "$p" in "$1"|"$1"/*) bind_rw "$p" ;; esac
	done < "$LIST"
}

rename_folder() {   # the folder's own entry lives in its (locked) parent, so the rename is done here
	r=$(unlock_point "${1:-}") || exit $?
	new=${2:-}
	case "$new" in ""|.|..|*/*) log "invalid name: $new"; exit 2 ;; esac
	parent=$(dirname -- "$r"); [ "$parent" = . ] && nr=$new || nr=$parent/$new
	[ "$nr" = "$r" ] && exit 0
	[ -e "$RW/$nr" ] && { log "already exists: $nr"; exit 1; }
	unmount_tree "$r" || exit 1
	if ! mv -- "$RW/$r" "$RW/$nr"; then log "rename failed: $r"; remount_tree "$r"; exit 1; fi
	awk -v r="$r" -v n="$nr" '{ if ($0 == r) print n; else if (index($0, r "/") == 1) print n substr($0, length(r) + 1); else print }' \
		"$LIST" > "$LIST.new" && mv "$LIST.new" "$LIST" && chmod 644 "$LIST"
	remount_tree "$nr"
	notify_files "$nr"
	log "renamed: $r -> $nr"
}

delete_folder() {   # permanent: the read-only drive has no Trash (GNOME Files asks first)
	r=$(unlock_point "${1:-}") || exit $?
	unmount_tree "$r" || exit 1
	if ! rm -rf -- "${RW:?}/$r"; then log "delete failed (partly deleted?): $r"; remount_tree "$r"; exit 1; fi
	awk -v r="$r" '$0 != r && index($0, r "/") != 1' "$LIST" > "$LIST.new" && mv "$LIST.new" "$LIST" && chmod 644 "$LIST"
	notify_files "$(dirname -- "$r")"
	log "deleted: $r"
}

status() {
	mounted "$MAIN" || { echo "not mounted"; return; }
	hibernated && echo "volume: read-only (Windows hibernated)" || echo "volume: read-only"
	mount_targets | grep -E "^$MAIN/" | sed "s|^$MAIN/|unlocked: |"
}

case "${1:-}" in
start) start ;;
stop) stop ;;
unlock-folder) unlock_folder "${2:-}" ;;
lock-folder) lock_folder "${2:-}" ;;
rename-folder) rename_folder "${2:-}" "${3:-}" ;;
delete-folder) delete_folder "${2:-}" ;;
status) status ;;
*) echo "usage: $0 start|stop|unlock-folder PATH|lock-folder PATH|rename-folder PATH NEWNAME|delete-folder PATH|status" >&2; exit 2 ;;
esac
