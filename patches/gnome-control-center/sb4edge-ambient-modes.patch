@@ -57,6 +57,7 @@
     AdwViewStackPage *power_saving_stack_page;
 
     AdwSwitchRow *als_row;
+    AdwComboRow *als_mode_row;
     AdwPreferencesGroup *battery_charging_section;
     GtkListBox *battery_listbox;
     AdwSwitchRow *battery_percentage_row;
@@ -361,6 +362,62 @@
     g_ptr_array_add (self->devices, g_object_ref (device));
     g_signal_connect_object (G_OBJECT (device), "notify", G_CALLBACK (up_client_changed), self, G_CONNECT_SWAPPED);
     up_client_changed (self);
+}
+
+/* sb4edge: how the light sensor sets the brightness (gnome-settings-daemon "ambient-mode"; the row only shows when
+ * the installed gnome-settings-daemon has the key). */
+static const char *als_modes[] = { "adjust", "curve" };
+
+static gboolean
+als_mode_supported (CcPowerPanel *self)
+{
+    g_autoptr(GSettingsSchema) schema = NULL;
+
+    g_object_get (self->gsd_settings, "settings-schema", &schema, NULL);
+    return schema && g_settings_schema_has_key (schema, "ambient-mode");
+}
+
+static void
+als_mode_update_subtitle (CcPowerPanel *self)
+{
+    if (adw_combo_row_get_selected (self->als_mode_row) == 1)
+        adw_action_row_set_subtitle (ADW_ACTION_ROW (self->als_mode_row),
+                                     _("Room light sets the brightness; the slider shifts it up or down"));
+    else {
+        g_autofree char *subtitle = g_strdup_printf (_("Room light moves the brightness up to %d%% above or below the slider"),
+                                                     g_settings_get_int (self->gsd_settings, "ambient-adjust-range"));
+        adw_action_row_set_subtitle (ADW_ACTION_ROW (self->als_mode_row), subtitle);
+    }
+}
+
+static void
+als_mode_row_changed_cb (CcPowerPanel *self)
+{
+    guint selected = adw_combo_row_get_selected (self->als_mode_row);
+
+    if (selected < G_N_ELEMENTS (als_modes))
+        g_settings_set_string (self->gsd_settings, "ambient-mode", als_modes[selected]);
+    als_mode_update_subtitle (self);
+}
+
+static void
+als_mode_sync (CcPowerPanel *self)
+{
+    g_autofree char *mode = NULL;
+
+    if (!als_mode_supported (self)) {
+        gtk_widget_set_visible (GTK_WIDGET (self->als_mode_row), FALSE);
+        return;
+    }
+    mode = g_settings_get_string (self->gsd_settings, "ambient-mode");
+    g_signal_handlers_block_by_func (self->als_mode_row, als_mode_row_changed_cb, self);
+    adw_combo_row_set_selected (self->als_mode_row, g_strcmp0 (mode, "curve") == 0 ? 1 : 0);
+    g_signal_handlers_unblock_by_func (self->als_mode_row, als_mode_row_changed_cb, self);
+    als_mode_update_subtitle (self);
+    gtk_widget_set_visible (GTK_WIDGET (self->als_mode_row),
+                            gtk_widget_get_visible (GTK_WIDGET (self->als_row)));
+    gtk_widget_set_sensitive (GTK_WIDGET (self->als_mode_row),
+                              g_settings_get_boolean (self->gsd_settings, "ambient-enabled"));
 }
 
