+/* sb4edge: "When the lid is closed" on the Power Saving page, like Windows' power options: Do nothing / Sleep /
+ * Hibernate / Shut down, separately on battery and plugged in (gnome-settings-daemon keys lid-close-battery-action
+ * and lid-close-ac-action). Only shown on machines that have a lid. */
+static void
+populate_lid_close_row (CcPowerPanel *self, CcNumberRow *row)
+{
+    static const struct {
+        char *name;
+        GsdPowerActionType value;
+        size_t availability;
+    } actions[] = { { N_("Do Nothing"), GSD_POWER_ACTION_NOTHING, 0 },
+                    { N_("Sleep"), GSD_POWER_ACTION_SUSPEND, offsetof (CcPowerPanel, can_suspend) },
+                    { N_("Hibernate"), GSD_POWER_ACTION_HIBERNATE, offsetof (CcPowerPanel, can_hibernate) },
+                    { N_("Shut Down"), GSD_POWER_ACTION_SHUTDOWN, offsetof (CcPowerPanel, can_shutdown) } };
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (actions); i++) {
+        if (actions[i].value != GSD_POWER_ACTION_NOTHING) {
+            /* The lid closes without anyone confirming anything, so the action must work unattended */
+            ActionAvailability availability = G_STRUCT_MEMBER (ActionAvailability, self, actions[i].availability);
+            if (availability < ACTION_AUTOMATIC)
+                continue;
+        }
+        cc_number_row_add_value_full (row, actions[i].value, _(actions[i].name), CC_NUMBER_ORDER_DEFAULT);
+    }
+}
+
+static void
+setup_lid_close_section (CcPowerPanel *self)
+{
+    g_autoptr(GSettingsSchema) schema = NULL;
+
+    if (!self->up_client || !up_client_get_lid_is_present (self->up_client))
+        return;
+
+    g_object_get (self->gsd_settings, "settings-schema", &schema, NULL);
+    if (!schema || !g_settings_schema_has_key (schema, "lid-close-battery-action") ||
+        !g_settings_schema_has_key (schema, "lid-close-ac-action"))
+        return;
+
+    populate_lid_close_row (self, self->lid_close_battery_row);
+    populate_lid_close_row (self, self->lid_close_ac_row);
+    cc_number_row_bind_settings (self->lid_close_battery_row, self->gsd_settings, "lid-close-battery-action");
+    cc_number_row_bind_settings (self->lid_close_ac_row, self->gsd_settings, "lid-close-ac-action");
+    gtk_widget_set_visible (GTK_WIDGET (self->lid_close_group), TRUE);
+}
