 				     const struct dpu_intf_cfg *cfg,
 				     void __iomem *addr,
@@ -668,5 +708,12 @@ struct dpu_hw_intf *dpu_hw_intf_init(struct drm_device *dev,
 	if (mdss_rev->core_major_ver >= 7)
 		c->ops.program_intf_cmd_cfg = dpu_hw_intf_program_intf_cmd_cfg;
 
+	/* sb4edge: AVR on DP/eDP interfaces (written for X1E80100, DPU 9.2) */
+	if (mdss_rev->core_major_ver >= 9 && cfg->type == INTF_DP) {
+		c->ops.avr_setup = dpu_hw_intf_avr_setup;
+		c->ops.avr_ctrl = dpu_hw_intf_avr_ctrl;
+		c->ops.avr_trigger = dpu_hw_intf_avr_trigger;
+	}
+
 	return c;
 }
