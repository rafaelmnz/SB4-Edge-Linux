+	ret = device_create_file(dev, &dev_attr_inject);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, pmic_glink_altmode_remove_inject, dev);
+	if (ret)
+		return ret;
+
 	altmode->client = devm_pmic_glink_client_alloc(dev,
 						       altmode->owner_id,
 						       pmic_glink_altmode_callback,
