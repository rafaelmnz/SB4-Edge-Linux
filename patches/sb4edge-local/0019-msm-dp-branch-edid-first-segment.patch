--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -269,6 +269,37 @@
 	return lttpr_count;
 }
 
+/*
+ * sb4edge: EDID block reader for DP branch devices (DP-to-HDMI adapters) that cannot read EDID blocks
+ * past the first segment; see below.
+ */
+static int msm_dp_read_edid_block(void *data, u8 *buf, unsigned int block, size_t len)
+{
+	struct i2c_adapter *ddc = data;
+	u8 seg = block >> 1, off = (block & 1) * EDID_LENGTH;
+	struct i2c_msg m[3] = {
+		{ .addr = 0x30, .flags = 0, .len = 1, .buf = &seg },
+		{ .addr = 0x50, .flags = 0, .len = 1, .buf = &off },
+		{ .addr = 0x50, .flags = I2C_M_RD, .len = len, .buf = buf },
+	};
+	int n = seg ? 3 : 2, i;
+
+	for (i = 0; i < 3; i++)
+		if (i2c_transfer(ddc, &m[3 - n], n) == n)
+			return 0;
+	if (seg) {
+		/*
+		 * The adapter NACKs the E-DDC segment pointer (0x30), so blocks 2+ (HF-EEODB EDIDs, e.g. the
+		 * Odyssey G95NC: 384 bytes) cannot be read. Hand back a zero block: DRM drops it as invalid
+		 * and keeps the base and CTA blocks instead of failing the whole EDID.
+		 */
+		pr_info_once("sb4edge: DP adapter rejects EDID segment pointer, ignoring blocks 2+\n");
+		memset(buf, 0, len);
+		return 0;
+	}
+	return -EIO;
+}
+
 static int msm_dp_display_process_hpd_high(struct msm_dp_display_private *dp)
 {
 	struct drm_connector *connector = dp->msm_dp_display.connector;
@@ -301,10 +332,10 @@
 		goto end;
 
 	drm_edid = drm_edid_read_ddc(connector, &dp->aux->ddc);
-	/* sb4edge: an adapter that just woke up can need a moment more for the monitor's EDID */
-	for (int i = 0; !drm_edid && drm_dp_is_branch(dpcd) && i < 5; i++) {
-		msleep(100);
-		drm_edid = drm_edid_read_ddc(connector, &dp->aux->ddc);
+	if (!drm_edid && drm_dp_is_branch(dpcd)) {
+		drm_edid = drm_edid_read_custom(connector, msm_dp_read_edid_block, &dp->aux->ddc);
+		drm_info(dp->drm_dev, "sb4edge: branch device EDID (first segment only): %s\n",
+			 drm_edid ? "ok" : "failed");
 	}
 	drm_edid_connector_update(connector, drm_edid);
 
