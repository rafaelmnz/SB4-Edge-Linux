+/*
+ * sb4edge: turn AVR on or off to follow the CRTC's VRR_ENABLED (a property change without a mode set), and
+ * reprogram the minimum refresh. Called before each frame's flush; the INTF flush bit latches the change.
+ */
+static void dpu_encoder_phys_vid_update_avr(struct dpu_encoder_phys *phys_enc)
+{
+	struct dpu_hw_intf *intf = phys_enc->hw_intf;
+	struct dpu_hw_intf_timing_params timing = { 0 };
+	struct drm_display_mode mode;
+	u32 min_fps, fps, want = DPU_INTF_AVR_OFF;
+	unsigned long lock_flags;
+
+	if (!intf || !intf->ops.avr_ctrl || !intf->ops.avr_setup ||
+	    phys_enc->split_role != ENC_ROLE_SOLO)
+		return;
+
+	min_fps = dpu_encoder_get_vrr_min_fps(phys_enc->parent);
+	fps = drm_mode_vrefresh(&phys_enc->cached_mode);
+	if (min_fps && fps > min_fps)
+		want = msm_vrr_mode == 2 ? DPU_INTF_AVR_ONE_SHOT : DPU_INTF_AVR_CONTINUOUS;
+	if (want == phys_enc->avr_mode)
+		return;
+
+	drm_mode_init(&mode, &phys_enc->cached_mode);
+	drm_mode_to_intf_timing_params(phys_enc, &mode, &timing);
+
+	spin_lock_irqsave(phys_enc->enc_spinlock, lock_flags);
+	if (want != DPU_INTF_AVR_OFF)
+		intf->ops.avr_setup(intf, &timing, fps, min_fps);
+	intf->ops.avr_ctrl(intf, want);
+	spin_unlock_irqrestore(phys_enc->enc_spinlock, lock_flags);
+	if (phys_enc->hw_ctl->ops.update_pending_flush_intf)
+		phys_enc->hw_ctl->ops.update_pending_flush_intf(phys_enc->hw_ctl, intf->idx);
+
+	DRM_INFO("sb4edge: intf %d AVR %u (%u..%u Hz)\n", intf->idx - INTF_0, want, min_fps, fps);
+	phys_enc->avr_mode = want;
+}
