+/*
+ * sb4edge: variable refresh (AVR) on eDP video mode. Read by the DP connector code as well (msm_vrr_mode).
+ *  0 = off (no vrr_capable property, nothing changes)
+ *  1 = AVR (continuous) while the compositor sets VRR_ENABLED (GNOME: fullscreen windows only)
+ *  2 = same, AVR one-shot mode
+ *  3 = AVR (continuous) whenever the panel is VRR capable: every commit starts a frame at once (up to the mode's
+ *      refresh), and with no commits the panel drops to the EDID minimum ("desktop" VRR)
+ */
+int msm_vrr_mode;
+module_param_named(vrr, msm_vrr_mode, int, 0444);
+MODULE_PARM_DESC(vrr, "sb4edge: eDP variable refresh: 0 off, 1 when VRR_ENABLED, 2 same one-shot, 3 always");
