+/*
+ * sb4edge: AVR (adaptive variable refresh), the timing engine half of Qualcomm's "Qsync" (from the downstream
+ * SDE driver, sde_hw_intf.c). With AVR on, the vertical front porch is extended until a trigger or until the
+ * frame reaches INTF_AVR_VTOTAL pixels (the minimum refresh rate), so frames start when the compositor commits.
+ */
+static void dpu_hw_intf_avr_setup(struct dpu_hw_intf *intf,
+				  const struct dpu_hw_intf_timing_params *p,
+				  u32 default_fps, u32 min_fps)
+{
+	struct dpu_hw_blk_reg_map *c = &intf->hw;
+	u32 hsync_period, vsync_period, vsync_period_slow;
+
+	hsync_period = p->hsync_pulse_width + p->h_back_porch + p->width + p->h_front_porch;
+	vsync_period = p->vsync_pulse_width + p->v_back_porch + p->height + p->v_front_porch;
+	vsync_period_slow = vsync_period;
+	if (min_fps && default_fps > min_fps)
+		vsync_period_slow += mult_frac(vsync_period, default_fps - min_fps, min_fps);
+
+	DPU_REG_WRITE(c, INTF_AVR_VTOTAL, vsync_period_slow * hsync_period);
+}
+
+static void dpu_hw_intf_avr_ctrl(struct dpu_hw_intf *intf, u32 mode)
+{
+	struct dpu_hw_blk_reg_map *c = &intf->hw;
+	u32 avr_ctrl = 0, avr_mode = 0;
+
+	if (mode != DPU_INTF_AVR_OFF) {
+		avr_ctrl = BIT(0);
+		if (mode == DPU_INTF_AVR_ONE_SHOT)
+			avr_mode = BIT(0) | BIT(8);
+	}
+	DPU_REG_WRITE(c, INTF_AVR_CONTROL, avr_ctrl);
+	DPU_REG_WRITE(c, INTF_AVR_MODE, avr_mode);
+}
+
+static void dpu_hw_intf_avr_trigger(struct dpu_hw_intf *intf)
+{
+	DPU_REG_WRITE(&intf->hw, INTF_AVR_TRIGGER, 0x1);
+}
