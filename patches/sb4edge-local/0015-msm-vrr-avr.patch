+/**
+ * dpu_encoder_get_vrr_min_fps - sb4edge: minimum refresh for AVR, or 0 when VRR is not in use
+ * @drm_enc: encoder
+ *
+ * Non-zero only when msm.vrr is set, the CRTC has VRR_ENABLED and the connector reports
+ * vrr_capable with an EDID refresh range (display_info.monitor_range).
+ */
+u32 dpu_encoder_get_vrr_min_fps(struct drm_encoder *drm_enc)
+{
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+	struct drm_connector *conn = dpu_enc->connector;
+	struct drm_object_properties *props;
+	u64 capable = 0;
+	int i;
+
+	if (!msm_vrr_mode || !conn || !conn->vrr_capable_property || !drm_enc->crtc || !drm_enc->crtc->state)
+		return 0;
+	if (msm_vrr_mode != 3 && !drm_enc->crtc->state->vrr_enabled)
+		return 0;
+	/* vrr_capable is immutable: its value lives in the object's property list (no atomic state) */
+	props = conn->base.properties;
+	for (i = 0; props && i < props->count; i++)
+		if (props->properties[i] == conn->vrr_capable_property)
+			capable = props->values[i];
+	if (!capable)
+		return 0;
+	return conn->display_info.monitor_range.min_vfreq;
 }
 
