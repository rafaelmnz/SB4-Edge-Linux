 #include "config.h"
+#include <math.h>
 
 #include <stdlib.h>
 #include <string.h>
@@ -98,6 +99,38 @@
 /* Normalize against this factor of the current absolute reading.
  * The value has been chosen arbitrarily but seems to work in practice. */
 #define GSD_AMBIENT_NORMALIZE_CONSTANT (1.5f)
+
+/* sb4edge: 'adjust' mode reaches its full range when the light changes this many times (log2: 3 = 8x). */
+#define GSD_AMBIENT_ADJUST_OCTAVES      (3.0)
+
+/* sb4edge: 'curve' mode, lux -> brightness percent, interpolated on log10(lux). gnome-shell adds
+ * (slider - 50 %) to the target, so with the slider in the middle these are the brightnesses you get. */
+static const struct { double lux; double percent; } ambient_curve[] = {
+        {    1.0,   8.0 },
+        {    5.0,  20.0 },
+        {   20.0,  35.0 },
+        {   80.0,  50.0 },
+        {  300.0,  65.0 },
+        { 1000.0,  80.0 },
+        { 5000.0, 100.0 },
+};
+
+static double
+ambient_curve_percent (double lux)
+{
+        guint i, n = G_N_ELEMENTS (ambient_curve);
+
+        if (lux <= ambient_curve[0].lux)
+                return ambient_curve[0].percent;
+        for (i = 1; i < n; i++) {
+                if (lux <= ambient_curve[i].lux) {
+                        double x0 = log10 (ambient_curve[i - 1].lux), x1 = log10 (ambient_curve[i].lux);
+                        double t = (log10 (lux) - x0) / (x1 - x0);
+                        return ambient_curve[i - 1].percent + t * (ambient_curve[i].percent - ambient_curve[i - 1].percent);
+                }
+        }
+        return ambient_curve[n - 1].percent;
+}
 
 #define GSD_OVERLAPPING_SLEEP_WARNING_SEPARATION 30 /* Seconds */
 
