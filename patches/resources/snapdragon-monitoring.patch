diff --git a/src/devices/npu/hexagon.rs b/src/devices/npu/hexagon.rs
new file mode 100644
index 0000000..26631f9
--- /dev/null
+++ b/src/devices/npu/hexagon.rs
@@ -0,0 +1,64 @@
+use anyhow::{Result, ensure};
+use process_data::pci_slot::PciSlot;
+use std::path::{Path, PathBuf};
+
+use super::NpuImpl;
+use crate::devices::{pci::Device, snapdragon};
+use crate::utils::read_parsed;
+
+#[derive(Clone, Debug)]
+pub struct Hexagon {
+    remoteproc: PathBuf,
+    sensors: Vec<PathBuf>,
+}
+
+impl Hexagon {
+    pub fn discover() -> Option<Self> {
+        let remoteproc = glob::glob("/sys/class/remoteproc/remoteproc*")
+            .ok()?
+            .flatten()
+            .find(|path| {
+                snapdragon::compatible(&path.join("device/of_node"), b"qcom,x1e80100-cdsp-pas")
+            })?;
+        Some(Self {
+            remoteproc,
+            sensors: snapdragon::thermal_inputs("nsp"),
+        })
+    }
+}
+
+impl NpuImpl for Hexagon {
+    fn device(&self) -> Option<&'static Device> {
+        None
+    }
+    fn pci_slot(&self) -> Option<PciSlot> {
+        None
+    }
+    fn driver(&self) -> &str {
+        "qcom_q6v5_pas"
+    }
+    fn sysfs_path(&self) -> &Path {
+        &self.remoteproc
+    }
+    fn first_hwmon(&self) -> Option<&Path> {
+        None
+    }
+    fn name(&self) -> Result<String> {
+        Ok("Qualcomm Hexagon NPU".into())
+    }
+    fn usage(&self) -> Result<f64> {
+        let load: u32 = read_parsed("/sys/module/sb4_cdsp_stats/parameters/load_permille")?;
+        ensure!(load <= 1000, "invalid CDSP load sample");
+        Ok(f64::from(load) / 1000.0)
+    }
+
+    fn temperature(&self) -> Result<f64> {
+        snapdragon::hottest(&self.sensors)
+    }
+    fn firmware_state(&self) -> Option<String> {
+        read_parsed(self.remoteproc.join("state")).ok()
+    }
+    fn max_tops(&self) -> Result<u64> {
+        Ok(45)
+    }
+}
