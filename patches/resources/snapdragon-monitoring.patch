diff --git a/src/devices/snapdragon.rs b/src/devices/snapdragon.rs
new file mode 100644
index 0000000..e1c35a3
--- /dev/null
+++ b/src/devices/snapdragon.rs
@@ -0,0 +1,33 @@
+use crate::utils::read_parsed;
+use anyhow::{Context, Result};
+use std::{
+    fs,
+    path::{Path, PathBuf},
+    sync::LazyLock,
+};
+
+pub fn compatible(node: &Path, id: &[u8]) -> bool {
+    fs::read(node.join("compatible"))
+        .is_ok_and(|data| data.split(|&byte| byte == 0).any(|entry| entry == id))
+}
+
+pub static X_ELITE: LazyLock<bool> =
+    LazyLock::new(|| compatible(Path::new("/sys/firmware/devicetree/base"), b"qcom,x1e80100"));
+
+pub fn thermal_inputs(prefix: &str) -> Vec<PathBuf> {
+    glob::glob("/sys/class/thermal/thermal_zone*/type")
+        .unwrap()
+        .flatten()
+        .filter(|path| fs::read_to_string(path).is_ok_and(|name| name.starts_with(prefix)))
+        .map(|path| path.with_file_name("temp"))
+        .collect()
+}
+
+pub fn hottest(inputs: &[PathBuf]) -> Result<f64> {
+    inputs
+        .iter()
+        .filter_map(|path| read_parsed::<i64>(path).ok())
+        .max()
+        .map(|temp| temp as f64 / 1000.0)
+        .context("no readable temperature sensor")
+}
